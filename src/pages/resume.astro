---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ResumeEntry from '../components/ResumeEntry.astro';
import AchievementBlock from '../components/AchievementBlock.astro';
import TimelineRail from '../components/TimelineRail.astro';

const engagementManagerAchievements = [
  {
    headline:
      'Developed an agentic co-pilot for 5,000 relationship managers with $35M in projected benefits',
    bullets: [
      {
        label: 'Customer needs discovery',
        text: 'Conducted 20+ user interviews and focus groups, identifying an opportunity to help relationship managers engage customers more efficiently by reducing 30 minutes of outreach preparation to under 5 minutes',
      },
      {
        label: 'Product tradeoff decisions',
        text: 'Increased suggestion acceptance by 30 percentage points by setting a response-confidence threshold, trading suggestion frequency for greater user trust and adoption',
      },
      {
        label: 'Business case sizing and presentation',
        text: 'Identified a $35M value-capture opportunity from increasing customer-facing time and reducing administrative costs, securing C-suite funding to scale the product',
      },
    ],
  },
  {
    headline: 'Built an AI-native customer service agent for a major insurer, projected to reach 1M+ users',
    bullets: [
      {
        label: 'Problem definition',
        text: 'Set the product vision around customer frustration with low-quality chatbot responses, especially for policy-coverage questions, based on 20+ user interviews',
      },
      {
        label: 'AI product optimization',
        text: 'Found that the generalist-agent architecture missed reliability thresholds; enhanced RAG with sub-agent routing, improving self-service resolution by 10 percentage points',
      },
      {
        label: 'Product roadmap',
        text: 'Created an executive-endorsed multi-year roadmap with 8 prioritized capabilities selected for potential impact, technical feasibility and customer feedback',
      },
    ],
  },
  {
    headline:
      'Turned around a four-month delay in a product modernization effort for a Fortune 100 company',
    bullets: [
      {
        label: 'Agentic tool creation',
        text: 'Increased requirements development throughput >8X across 10+ product owners by building agentic tools converting legacy product documentation into epics and user stories',
      },
      {
        label: 'Feature prioritization',
        text: 'Unblocked development delays by reprioritizing roadmap, cutting bottom 40% low-value nice-to-have features, and resolving 30+ cross-functional blockers',
      },
      {
        label: 'Data-driven decision-making',
        text: 'Reduced decision turnaround time from >20 days to 7 days by launching a real-time Tableau decision dashboard and defining 9 north-star decision criteria',
      },
    ],
  },
];

const earlierMcKinseyAchievements = [
  {
    headline:
      'Led a customer experience transformation creating 10%+ growth in a priority customer segment',
    bullets: [
      {
        label: 'Growth experimentation',
        text: 'Launched a new customer acquisition program with value propositions selected through 10+ A/B tests, resulting in 3X conversion versus past campaigns',
      },
    ],
  },
  {
    headline: 'Redesigned the customer journey for a financial services application, improving CSAT by 10 percentage points',
    bullets: [
      {
        label: 'Customer pain point resolution',
        text: 'Identified 5 key friction points through 5+ focus groups and led 10+ ideation sessions to generate ideas including targeted onboarding and a personalized feed',
      },
    ],
  },
];
---

<BaseLayout title="Resume — Henry Hung" description="Henry Hung's resume — MBA candidate at Harvard Business School, formerly Engagement Manager at McKinsey & Company.">
  <Masthead />

  <div class="container resume">
    <header class="resume__header">
      <p class="eyebrow">Resume</p>
      <div class="resume__header-row">
        <h1>Henry Hung</h1>
        <a href="/henry-hung-resume.pdf" download class="mono resume__download">Download PDF ↓</a>
      </div>
      <p class="resume__role">MBA candidate, Harvard Business School — formerly Engagement Manager, McKinsey & Company</p>
    </header>

    <div class="resume-timeline">
      <TimelineRail count={3} />

      <div class="resume-timeline__content" data-timeline-content>
        <section class="resume__section">
          <h2>Experience</h2>
          <hr class="rule-heavy" />
          <div data-timeline-stop>
            <ResumeEntry
              role="Engagement Manager"
              org="McKinsey & Company"
              location="Boston, MA"
              dateRange="2025 – 2026"
              intro="Led 0-to-1 AI product development as sole Product Manager for cross-functional teams of more than 10 people."
            />
            <div class="resume__achievements">
              {engagementManagerAchievements.map((achievement) => (
                <AchievementBlock headline={achievement.headline} bullets={achievement.bullets} />
              ))}
            </div>
            <ResumeEntry
              role="Senior Business Analyst / Associate"
              org="McKinsey & Company"
              location="Boston, MA · Hong Kong"
              dateRange="2022 – 2025"
              intro="Earned top 5% ratings in every review and a fast-track promotion 6 months ahead of the standard timeline."
            />
            <div class="resume__achievements">
              {earlierMcKinseyAchievements.map((achievement) => (
                <AchievementBlock headline={achievement.headline} bullets={achievement.bullets} />
              ))}
            </div>
          </div>
        </section>

        <section class="resume__section">
          <h2>Education</h2>
          <hr class="rule-heavy" />
          <div data-timeline-stop>
            <ResumeEntry
              role="Candidate for Master of Business Administration"
              org="Harvard Business School"
              location="Cambridge, MA"
              dateRange="2026 – 2028"
              bullets={[
                "Built a section app to accelerate peer connections; it was adopted by more than 70% of the section, with other sections requesting replication. Partnered with HBS' Chief Information Security Officer to ensure policy compliance",
              ]}
            />
          </div>
          <div data-timeline-stop>
            <ResumeEntry
              role={[
                'Master of Computer and Information Technology (GPA: 4.0/4.0)',
                'BA Philosophy & Political Science, Phi Beta Kappa, Summa Cum Laude',
              ]}
              org="University of Pennsylvania"
              location="Philadelphia, PA"
              dateRange="2017 – 2022"
              bullets={[
                'Courses: Computer systems (Head TA), artificial intelligence, machine learning, product design',
                'Co-founded and led the Penn Philosophy Society; chairperson of Penn Manuscript Collective',
              ]}
            />
          </div>
        </section>
      </div>
    </div>

    <section class="resume__section resume__section--split">
      <div>
        <h2>Technical</h2>
        <hr class="rule-heavy" />
        <p class="resume__skills">Python, Java, SQL, Tableau · Figma, Jira, Miro, Confluence · Claude Code, Codex, Cursor</p>
      </div>
      <div>
        <h2>Personal</h2>
        <hr class="rule-heavy" />
        <p class="resume__skills">
          Fluent in English, Mandarin, and Cantonese. Enjoy trail running (100 km Trailwalker race), hiking (70 km
          Patagonia trek), soccer (led McKinsey Boston team), and reading — especially the history of business and
          technology.
        </p>
      </div>
    </section>
  </div>

  <SiteFooter />
</BaseLayout>

<style>
  .resume {
    padding-top: var(--space-11);
    padding-bottom: var(--space-14);
  }

  .resume__header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    margin-top: var(--space-2);
  }

  .resume__header h1 {
    font-size: 48px;
    line-height: 1.14;
    letter-spacing: -0.012em;
  }

  .resume__download {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    background: var(--accent);
    color: var(--paper);
    white-space: nowrap;
  }

  .resume__download:hover {
    background: var(--accent-hover);
    color: var(--paper);
  }

  .resume__role {
    margin-top: var(--space-5);
    font-size: 20px;
    line-height: 1.6;
    color: var(--text-soft);
    max-width: 640px;
  }

  .resume-timeline {
    margin-top: var(--space-14);
  }

  @media (min-width: 1024px) {
    .resume-timeline {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: var(--space-9);
      align-items: stretch;
    }
  }

  .resume-timeline .resume__section:first-child {
    margin-top: 0;
  }

  .resume__section {
    margin-top: var(--space-14);
  }

  .resume__section h2 {
    font-size: 36px;
    line-height: 1.2;
    padding-bottom: var(--space-6);
  }

  .resume__section--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-13);
  }

  .resume__skills {
    margin-top: var(--space-6);
    font-size: var(--text-base);
    line-height: 1.58;
    color: var(--text);
  }

  @media (max-width: 768px) {
    .resume__section--split {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 480px) {
    .resume__header h1 {
      font-size: 34px;
    }

    .resume__header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .resume__section h2 {
      font-size: 30px;
    }
  }
</style>
