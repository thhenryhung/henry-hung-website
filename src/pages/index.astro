---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PortfolioExplorer from '../components/PortfolioExplorer.astro';
import Background from '../components/Background.astro';
import SiteFooter from '../components/SiteFooter.astro';

const projects = (await getCollection('projects')).sort((a, b) =>
  a.data.order.localeCompare(b.data.order)
);
---

<BaseLayout title="Henry Hung — Product Manager">
  <Masthead />
  <Hero />

  <section class="container" id="portfolio">
    <SectionHeader title="Selected work" descriptor="People → decision → system → outcome" />
    <PortfolioExplorer projects={projects} />
  </section>

  <Background />
  <SiteFooter />
</BaseLayout>

<style>
  #portfolio {
    scroll-margin-top: 96px;
  }
</style>
