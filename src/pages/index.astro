---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PortfolioBook from '../components/PortfolioBook.astro';
import SiteFooter from '../components/SiteFooter.astro';

const projects = (await getCollection('projects')).sort((a, b) =>
  a.data.order.localeCompare(b.data.order)
);
---

<BaseLayout title="Henry Hung — Product Manager">
  <Masthead />
  <Hero />

  <section class="container" id="portfolio">
    <SectionHeader title="Portfolio" descriptor="Selected work, 20XX–present" />

    <div class="project-rows portfolio-list-fallback">
      {projects.map((project) => (
        <ProjectRow
          order={project.data.order}
          title={project.data.title}
          descriptor={project.data.descriptor}
          problem={project.data.problem}
          built={project.data.built}
          metric={project.data.metric}
          metricCaption={project.data.metricCaption}
          href={project.data.hasCaseStudy ? `/work/${project.id}` : undefined}
          demoUrl={project.data.demoUrl}
          demoNote={project.data.demoNote}
          screenshot={project.data.screenshot}
          screenshotAlt={project.data.screenshotAlt}
          diagramLabels={project.data.diagramLabels}
          tag={project.data.tag}
        />
      ))}
    </div>

    <div class="portfolio-book-wrap">
      <PortfolioBook projects={projects} />
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  .project-rows {
    display: flex;
    flex-direction: column;
  }

  .portfolio-book-wrap {
    display: none;
  }

  @media (min-width: 1024px) {
    .portfolio-book-wrap {
      display: block;
    }

    .portfolio-list-fallback {
      display: none;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .portfolio-book-wrap {
      display: none;
    }

    .portfolio-list-fallback {
      display: flex;
    }
  }

  :global(.no-js) .portfolio-book-wrap {
    display: none !important;
  }

  :global(.no-js) .portfolio-list-fallback {
    display: flex !important;
  }
</style>
