---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Masthead from '../../components/Masthead.astro';
import MetricBand from '../../components/MetricBand.astro';
import PullQuote from '../../components/PullQuote.astro';
import MockupFrame from '../../components/MockupFrame.astro';
import DecisionBlock from '../../components/DecisionBlock.astro';
import ConfidentialityNote from '../../components/ConfidentialityNote.astro';
import RequirementsVisuals from '../../components/RequirementsVisuals.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.hasCaseStudy);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const p = project.data;
const isClientProject = p.tag === 'Client anonymized';
const screenDisclaimer = 'Sanitized screen example to protect client confidentiality';

const bandCells = p.bandMetrics ?? [{ metric: p.metric, caption: p.metricCaption }];

const problemParagraphs = (p.caseStudyProblem ?? p.problem).split('\n\n');
const builtText = p.caseStudyBuilt ?? p.built;
const outcomeParagraphs = (p.outcome ?? '').split('\n\n').filter(Boolean);

const allProjects = (await getCollection('projects', ({ data }) => data.hasCaseStudy)).sort((a, b) =>
  a.data.order.localeCompare(b.data.order)
);
const currentIndex = allProjects.findIndex((proj) => proj.id === project.id);
const nextProject = allProjects[(currentIndex + 1) % allProjects.length];
---

<BaseLayout title={`${p.title} — Henry Hung`} description={p.descriptor}>
  <Masthead />

  <div class="container case-study">
    <article class="case-study__article">
      <nav class="case-study__entry-nav mono" aria-label="Case study navigation">
        <a href="/#portfolio">← Back to portfolio</a>
        <span>Case study — {p.order}</span>
      </nav>
      <h1 class="case-study__title">{p.title}</h1>
      <p class="case-study__standfirst">{p.standfirst}</p>

      <MetricBand cells={bandCells} />

      <section id="problem">
        <h2 class="case-study__section-h2"><span class="mono case-study__section-num">01</span> The problem</h2>
        {problemParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        {p.pullQuote && <PullQuote cite={p.pullQuoteCite}>{p.pullQuote}</PullQuote>}
      </section>

      <section id="built">
        <h2 class="case-study__section-h2"><span class="mono case-study__section-num">02</span> What I built</h2>
        <p>{builtText}</p>

        {p.screenshot && (
          <div class="case-study__screen-example">
            {isClientProject && <p class="mono case-study__screen-note">{screenDisclaimer}</p>}
            <MockupFrame label={p.screenshotAlt ?? `Product mockup for ${p.title}`}>
              <img src={p.screenshot} alt="" />
            </MockupFrame>
          </div>
        )}

        {p.demoUrl && (
          <div class="case-study__demo">
            <a href={p.demoUrl} class="mono" target="_blank" rel="noopener noreferrer">View live demo →</a>
            {p.demoNote && <p class="mono">{p.demoNote}</p>}
          </div>
        )}

        {project.id === 'agentic-requirements' && (
          <div class="case-study__screen-example">
            <p class="mono case-study__screen-note">{screenDisclaimer}</p>
            <RequirementsVisuals />
          </div>
        )}

      </section>

      <section id="decisions">
        <h2 class="case-study__section-h2"><span class="mono case-study__section-num">03</span> Key decisions</h2>
        {p.decisions?.map((d, i) => (
          <DecisionBlock label={`Decision 0${i + 1}`} title={d.title} chose={d.chose} over={d.over} because={d.because} />
        ))}
      </section>

      <section id="outcome">
        <h2 class="case-study__section-h2"><span class="mono case-study__section-num">04</span> Outcome</h2>
        {outcomeParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>

      {isClientProject ? (
        <ConfidentialityNote />
      ) : p.demoUrl ? (
        <div class="case-study__project-note">
          <p class="mono case-study__project-note-label">About the demo</p>
          <p class="case-study__project-note-text">
            This was an independent HBS side project, not client work. The public demo uses fictional
            profiles and events and is separate from the private version used by the section.
          </p>
        </div>
      ) : null}
    </article>
  </div>

  <footer class="container case-study__footer">
    <hr class="rule-heavy" />
    <div class="case-study__footer-row">
      <a href="/#portfolio" class="mono">← Back to portfolio</a>
      <a href={`/work/${nextProject.id}`} class="mono">Next: {nextProject.data.title} →</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .case-study {
    max-width: 940px;
    padding-top: var(--space-11);
    padding-bottom: var(--space-14);
  }

  .case-study__article {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  .case-study__entry-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule);
    color: var(--meta);
  }

  .case-study__entry-nav a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    color: var(--accent);
  }

  .case-study__entry-nav a:hover {
    color: var(--accent-hover);
  }

  .case-study__title {
    font-size: 48px;
    line-height: 1.14;
    letter-spacing: -0.012em;
    margin-top: var(--space-5);
  }

  .case-study__standfirst {
    margin-top: var(--space-8);
    font-size: 21px;
    line-height: 1.6;
    color: var(--text-soft);
    max-width: 640px;
  }

  .case-study__article > :global(section) {
    margin-top: var(--space-14);
  }

  .case-study__article :global(.metric-band) {
    margin-top: var(--space-11);
  }

  .case-study__demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .case-study__demo a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    background: var(--accent);
    color: var(--paper);
  }

  .case-study__demo a:hover {
    background: var(--accent-hover);
    color: var(--paper);
  }

  .case-study__demo p {
    color: var(--meta);
  }

  .case-study__section-h2 {
    font-size: 34px;
    line-height: 1.2;
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
  }

  .case-study__section-num {
    color: var(--accent);
  }

  .case-study__article section p {
    margin-top: var(--space-6);
    font-size: var(--text-base);
    line-height: 1.72;
    max-width: 680px;
  }

  .case-study__article section :global(.diagram-frame),
  .case-study__article section :global(.mockup-frame) {
    margin-top: var(--space-9);
  }

  .case-study__screen-note {
    margin-top: var(--space-9) !important;
    margin-bottom: var(--space-3);
    font-size: 11px !important;
    line-height: 1.45 !important;
    color: var(--meta);
  }

  .case-study__screen-note + :global(.mockup-frame),
  .case-study__screen-note + :global(.requirements-visuals) {
    margin-top: 0;
  }

  .case-study__project-note {
    margin-top: var(--space-14);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .case-study__project-note-label {
    color: var(--meta);
  }

  .case-study__project-note-text {
    max-width: 640px;
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .case-study__footer {
    max-width: 940px;
    padding-bottom: var(--space-13);
  }

  .case-study__footer-row {
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-8);
  }

  @media (max-width: 768px) {
    .case-study__entry-nav {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }

  }

  @media (max-width: 480px) {
    .case-study__title {
      font-size: 34px;
    }

    .case-study__section-h2 {
      font-size: 30px;
    }

    .case-study__footer-row {
      flex-direction: column;
      gap: var(--space-4);
    }
  }
</style>
