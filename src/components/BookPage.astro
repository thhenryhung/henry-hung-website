---
interface Props {
  order: string;
  title: string;
  descriptor: string;
  problem: string;
  built: string;
  metric: string;
  metricCaption: string;
  href?: string;
  demoUrl?: string;
  demoNote?: string;
  screenshot?: string;
  screenshotAlt?: string;
  diagramLabels?: string[];
  tag?: string;
}
const {
  order,
  title,
  descriptor,
  problem,
  built,
  metric,
  metricCaption,
  href,
  demoUrl,
  demoNote,
  screenshot,
  screenshotAlt,
  diagramLabels,
  tag,
} = Astro.props;
---

<div class="book-page-content">
  <div class="book-page-content__index mono">{order}</div>

  <div class="book-page-content__main">
    <h3 class="book-page-content__title">{title}</h3>
    <p class="book-page-content__descriptor">{descriptor}</p>

    <div class="book-page-content__fields">
      <div class="book-page-content__field">
        <p class="mono book-page-content__field-label">Problem</p>
        <p class="book-page-content__field-value">{problem}</p>
      </div>
      <div class="book-page-content__field">
        <p class="mono book-page-content__field-label">Built</p>
        <p class="book-page-content__field-value">{built}</p>
      </div>
    </div>

    {href ? (
      <a href={href} class="mono book-page-content__link">Read the case study →</a>
    ) : demoUrl ? (
      <div>
        <a href={demoUrl} class="mono book-page-content__link" target="_blank" rel="noopener noreferrer">
          View live demo →
        </a>
        {demoNote && <p class="mono book-page-content__demo-note">{demoNote}</p>}
      </div>
    ) : (
      <p class="mono book-page-content__link book-page-content__link--disabled">Case study coming soon</p>
    )}
  </div>

  <div class="book-page-content__aside">
    <div class="book-page-content__diagram" role="img" aria-label={screenshotAlt ?? `Simplified architecture diagram for ${title}`}>
      {screenshot ? (
        <img src={screenshot} alt="" class="book-page-content__screenshot" />
      ) : diagramLabels && diagramLabels.length === 2 ? (
        <svg viewBox="0 0 300 168" xmlns="http://www.w3.org/2000/svg">
          <line x1="140" y1="84" x2="176" y2="84" stroke="var(--diagram-faint)" />
          <rect x="34" y="66" width="106" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="87" y="88" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[0]}</text>
          <rect x="176" y="66" width="106" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="229" y="88" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[1]}</text>
        </svg>
      ) : diagramLabels && diagramLabels.length === 3 ? (
        <svg viewBox="0 0 300 168" xmlns="http://www.w3.org/2000/svg">
          <rect x="16" y="24" width="88" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="60" y="46" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[0]}</text>
          <rect x="196" y="24" width="88" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="240" y="46" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[1]}</text>
          <rect x="106" y="108" width="88" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="150" y="130" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[2]}</text>
          <line x1="104" y1="42" x2="196" y2="42" stroke="var(--diagram-faint)" />
          <line x1="150" y1="60" x2="150" y2="108" stroke="var(--diagram-faint)" />
        </svg>
      ) : (
        <svg viewBox="0 0 300 168" xmlns="http://www.w3.org/2000/svg">
          <rect x="20" y="24" width="80" height="36" fill="none" stroke="var(--diagram-line)" />
          <rect x="200" y="24" width="80" height="36" fill="none" stroke="var(--diagram-line)" />
          <rect x="110" y="108" width="80" height="36" fill="none" stroke="var(--diagram-line)" />
          <line x1="100" y1="42" x2="200" y2="42" stroke="var(--diagram-faint)" />
          <line x1="150" y1="60" x2="150" y2="108" stroke="var(--diagram-faint)" />
        </svg>
      )}
    </div>

    <div class="book-page-content__metric">
      <hr class="rule-heavy" />
      <p class="book-page-content__metric-value">{metric}</p>
      <p class="book-page-content__metric-caption">{metricCaption}</p>
    </div>
    {tag && <p class="mono book-page-content__tag">{tag}</p>}
  </div>
</div>

<style>
  .book-page-content {
    display: grid;
    grid-template-columns: 36px 1fr 240px;
    gap: var(--space-9);
    height: 100%;
    padding: var(--space-9);
    overflow-y: auto;
  }

  .book-page-content__index {
    color: var(--accent);
    font-size: 11px;
  }

  .book-page-content__title {
    font-size: 24px;
    line-height: 1.25;
  }

  .book-page-content__descriptor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 15px;
    line-height: 1.4;
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  .book-page-content__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-7);
    max-width: 480px;
  }

  .book-page-content__field-label {
    color: var(--meta);
    margin-bottom: var(--space-1);
  }

  .book-page-content__field-value {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text);
  }

  .book-page-content__link {
    display: inline-block;
    margin-top: var(--space-6);
    color: var(--accent);
  }

  .book-page-content__link--disabled {
    color: var(--meta);
  }

  .book-page-content__demo-note {
    margin-top: var(--space-2);
    color: var(--meta);
  }

  .book-page-content__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .book-page-content__diagram {
    width: 100%;
    aspect-ratio: 300 / 168;
    background: var(--panel);
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .book-page-content__diagram svg {
    width: 100%;
    height: 100%;
  }

  .book-page-content__screenshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .book-page-content__metric-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 32px;
    line-height: 1;
    color: var(--accent);
    margin-top: var(--space-4);
  }

  .book-page-content__metric-caption {
    margin-top: var(--space-2);
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-soft);
  }

  .book-page-content__tag {
    color: var(--meta);
  }

  @media (max-width: 1200px) {
    .book-page-content {
      grid-template-columns: 32px 1fr 200px;
      gap: var(--space-7);
      padding: var(--space-7);
    }

    .book-page-content__title {
      font-size: 20px;
    }
  }
</style>
