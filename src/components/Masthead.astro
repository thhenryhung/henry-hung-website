---
interface Props {
  showSectionNav?: boolean;
}
const { showSectionNav = true } = Astro.props;
---

<header class="masthead">
  <div class="container masthead__inner">
    <a href="/" class="masthead__wordmark mono">Henry Hung</a>

    {showSectionNav && (
      <nav class="masthead__nav mono" aria-label="Primary">
        <a href="/#portfolio">Portfolio</a>
        <a href="/resume">Resume</a>
        <a href="/#contact" class="masthead__cta">Get in touch</a>
      </nav>
    )}

    <button
      class="masthead__menu-btn"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      id="menu-toggle"
    >
      <span aria-hidden="true">☰</span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav mono" aria-label="Mobile" hidden>
    <a href="/#portfolio">Portfolio</a>
    <a href="/resume">Resume</a>
    <a href="/#contact" class="masthead__cta masthead__cta--mobile">Get in touch</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    if (nav) nav.hidden = expanded;
  });
</script>

<style>
  .masthead {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .masthead__wordmark {
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--ink);
  }

  .masthead__nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .masthead__nav a {
    color: var(--text-soft);
  }

  .masthead__nav a:hover {
    color: var(--accent);
  }

  .masthead__cta {
    color: var(--paper) !important;
    background: var(--ink);
    padding: var(--space-2) var(--space-5);
  }

  .masthead__cta:hover {
    background: var(--accent-hover);
    color: var(--paper) !important;
  }

  .masthead__cta--mobile {
    display: inline-block;
    align-self: flex-start;
  }

  .masthead__menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink);
    cursor: pointer;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .masthead__nav {
      display: none;
    }

    .masthead__menu-btn {
      display: flex;
    }

    .mobile-nav {
      flex-direction: column;
      border-top: 1px solid var(--rule);
      padding: var(--space-6) var(--space-8);
      gap: var(--space-6);
    }

    .mobile-nav[hidden] {
      display: none;
    }

    .mobile-nav:not([hidden]) {
      display: flex;
    }

    .mobile-nav a {
      color: var(--text-soft);
    }
  }
</style>
