---
interface Props {
  showSectionNav?: boolean;
}
const { showSectionNav = true } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isPortfolio = pathname === '/';
const isResume = pathname === '/resume';
---

<header class="masthead">
  <div class="container masthead__inner">
    <a href="/" class="masthead__wordmark mono">Henry Hung</a>

    <div class="masthead__right">
      {showSectionNav && (
        <nav class="masthead__nav mono" aria-label="Primary">
          <a href="/#portfolio" aria-current={isPortfolio ? 'page' : undefined}>Portfolio</a>
          <a href="/resume" aria-current={isResume ? 'page' : undefined}>Resume</a>
          <a href="/#contact" class="masthead__cta">Let's talk →</a>
        </nav>
      )}

      <button
        class="masthead__menu-btn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        id="menu-toggle"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav mono" aria-label="Mobile" hidden>
    <a href="/#portfolio" aria-current={isPortfolio ? 'page' : undefined}>Portfolio</a>
    <a href="/resume" aria-current={isResume ? 'page' : undefined}>Resume</a>
    <a href="/#contact" class="masthead__cta masthead__cta--mobile">Let's talk →</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');

  const setMenuOpen = (open) => {
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    const icon = toggle.querySelector('[aria-hidden="true"]');
    if (icon) icon.textContent = open ? '×' : '☰';
    nav.hidden = !open;
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      toggle.focus();
    }
  });
</script>

<style>
  .masthead {
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 30;
  }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .masthead__wordmark {
    font-size: 19px;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .masthead__right {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .masthead__nav {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .masthead__nav a {
    color: var(--text-soft);
  }

  .masthead__nav a:hover {
    color: var(--accent);
  }

  .masthead__nav a[aria-current='page'],
  .mobile-nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .masthead__cta {
    color: var(--paper) !important;
    background: var(--accent);
    padding: var(--space-3) var(--space-5);
  }

  .masthead__cta:hover {
    background: var(--accent-hover);
    color: var(--paper) !important;
  }

  .masthead__cta--mobile {
    display: inline-block;
    align-self: flex-start;
  }

  .masthead__menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink);
    cursor: pointer;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 768px) {
    .masthead__nav {
      display: none;
    }

    .masthead__menu-btn {
      display: flex;
    }

    .mobile-nav {
      flex-direction: column;
      border-top: 1px solid var(--rule);
      padding: var(--space-6) var(--space-8);
      gap: var(--space-6);
    }

    .mobile-nav[hidden] {
      display: none;
    }

    .mobile-nav:not([hidden]) {
      display: flex;
    }

    .mobile-nav a {
      color: var(--text-soft);
    }
  }
</style>
