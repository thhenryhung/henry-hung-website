---
interface Props {
  count: number;
}
const { count } = Astro.props;
---

<div class="resume-timeline__rail" id="timeline-rail" aria-hidden="true">
  <div class="resume-timeline__fill" id="timeline-fill"></div>
  {Array.from({ length: count }).map((_, i) => (
    <div class="resume-timeline__dot" data-dot-index={i}></div>
  ))}
</div>

<script>
  (function () {
    const rail = document.getElementById('timeline-rail');
    const fill = document.getElementById('timeline-fill');
    const content = document.querySelector('[data-timeline-content]');
    if (!rail || !fill || !content) return;
    if (!window.matchMedia('(min-width: 1024px)').matches) return;

    const stops = Array.from(document.querySelectorAll('[data-timeline-stop]'));
    const dots = Array.from(rail.querySelectorAll('.resume-timeline__dot'));

    let contentTop = 0;
    let contentHeight = 1;
    let stopFractions = [];

    function measure() {
      const rect = content.getBoundingClientRect();
      contentTop = rect.top + window.scrollY;
      contentHeight = content.offsetHeight || 1;
      stopFractions = stops.map((el) => {
        const r = el.getBoundingClientRect();
        const top = r.top + window.scrollY;
        return Math.min(1, Math.max(0, (top - contentTop) / contentHeight));
      });
      dots.forEach((dot, i) => {
        dot.style.top = stopFractions[i] * 100 + '%';
      });
    }

    let ticking = false;
    function update() {
      const triggerY = window.scrollY + window.innerHeight * 0.3;
      const fraction = Math.min(1, Math.max(0, (triggerY - contentTop) / contentHeight));
      fill.style.height = fraction * 100 + '%';
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', fraction >= stopFractions[i]);
      });
      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', () => {
      measure();
      update();
    });

    measure();
    update();
  })();
</script>

<style>
  .resume-timeline__rail {
    display: none;
    position: relative;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 1024px) {
    .resume-timeline__rail {
      display: block;
    }
  }

  .resume-timeline__rail::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--rule);
    transform: translateX(-50%);
  }

  .resume-timeline__fill {
    position: absolute;
    left: 50%;
    top: 4px;
    width: 1px;
    height: 0%;
    background: var(--accent);
    transform: translateX(-50%);
    transition: height 0.2s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .resume-timeline__fill {
      transition: none;
    }
  }

  .resume-timeline__dot {
    position: absolute;
    left: 50%;
    width: 9px;
    height: 9px;
    background: var(--paper);
    border: 1.5px solid var(--rule);
    transform: translate(-50%, -50%);
  }

  .resume-timeline__dot.is-active {
    background: var(--accent);
    border-color: var(--accent);
  }
</style>
