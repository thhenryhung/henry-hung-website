---
import PortraitFigure from './PortraitFigure.astro';

const proof = [
  { value: '3', label: 'zero-to-one AI products' },
  { value: '50+', label: 'interviews and focus groups' },
  { value: '10+', label: 'person product teams' },
  { value: '1M+', label: 'projected users' },
];
---

<section class="hero container">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="hero__intro" aria-label="Hi, I am Henry">
        <span aria-hidden="true" data-typewriter-text>Hi, I am Henry</span><span class="hero__cursor" aria-hidden="true"></span>
      </p>
      <h1 class="hero__headline">
        I understand how systems and people interact, and turn the insights into products that work
      </h1>
      <ul class="hero__lead">
        <li>Zero-to-one AI products and enterprise platform modernizations, from the first customer interview to a scaling product</li>
        <li>Four years at McKinsey across Boston and Hong Kong focusing on product development and management</li>
        <li>Master’s in Computer Science at UPenn, now an MBA Candidate at Harvard Business School</li>
      </ul>
      <div class="hero__actions mono">
        <a href="#portfolio" class="hero__primary">See portfolio ↓</a>
        <a href="/resume">View resume →</a>
      </div>
    </div>

    <div class="hero__portrait">
      <PortraitFigure feature />
    </div>
  </div>

  <div class="hero__proof" aria-label="Selected career proof points">
    {proof.map((item) => (
      <div class="hero__proof-item">
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </div>
    ))}
  </div>
</section>

<script>
  const intro = document.querySelector('[data-typewriter-text]');

  if (intro instanceof HTMLElement && !intro.dataset.typed) {
    intro.dataset.typed = 'true';
    const text = intro.textContent ?? '';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!reducedMotion) {
      intro.textContent = '';
      intro.closest('.hero__intro')?.classList.add('is-typing');

      let index = 0;
      const typeNextCharacter = () => {
        intro.textContent = text.slice(0, index + 1);
        index += 1;

        if (index < text.length) {
          window.setTimeout(typeNextCharacter, 90);
        } else {
          window.setTimeout(() => {
            intro.closest('.hero__intro')?.classList.remove('is-typing');
            intro.closest('.hero__intro')?.classList.add('is-typed');
          }, 700);
        }
      };

      window.setTimeout(typeNextCharacter, 350);
    } else {
      intro.closest('.hero__intro')?.classList.add('is-typed');
    }
  }
</script>

<style>
  .hero {
    padding-top: var(--space-14);
    padding-bottom: var(--space-12);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-13);
    align-items: start;
  }

  .hero__headline {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 600;
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    max-width: 820px;
    margin-top: var(--space-4);
  }

  .hero__intro {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 600;
    line-height: 1.15;
    color: var(--accent);
  }

  .hero__cursor {
    display: none;
    width: 2px;
    height: 0.9em;
    margin-left: 3px;
    background: currentColor;
    vertical-align: -0.04em;
  }

  .hero__intro.is-typing .hero__cursor {
    display: inline-block;
    animation: typewriter-cursor 0.75s steps(1, end) infinite;
  }

  @keyframes typewriter-cursor {
    0%, 48% {
      opacity: 1;
    }

    49%, 100% {
      opacity: 0;
    }
  }

  .hero__lead {
    display: grid;
    gap: var(--space-3);
    max-width: 670px;
    margin-top: var(--space-8);
    padding: 0;
    list-style: none;
    font-size: 19px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .hero__lead li {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
  }

  .hero__lead li::before {
    width: 5px;
    height: 5px;
    content: '';
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-2px);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-7);
    margin-top: var(--space-9);
  }

  .hero__actions a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .hero__primary {
    background: var(--accent);
    color: var(--paper);
    padding: var(--space-3) var(--space-5);
  }

  .hero__primary:hover {
    background: var(--accent-hover);
    color: var(--paper);
  }

  .hero__portrait {
    justify-self: end;
    align-self: start;
  }

  .hero__proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: var(--space-12);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .hero__proof-item {
    padding: var(--space-7) var(--space-6);
    border-right: 1px solid var(--rule);
  }

  .hero__proof-item:first-child {
    padding-left: 0;
  }

  .hero__proof-item:last-child {
    border-right: 0;
  }

  .hero__proof-item strong {
    display: block;
    font-family: var(--font-display);
    font-size: 40px;
    line-height: 1;
    color: var(--accent);
  }

  .hero__proof-item span {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-soft);
  }

  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--space-10);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-11);
      padding-bottom: var(--space-11);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero__headline {
      font-size: 42px;
      line-height: 1.08;
    }

    .hero__lead {
      font-size: 18px;
    }

    .hero__portrait {
      justify-self: start;
    }

    .hero__proof {
      grid-template-columns: repeat(2, 1fr);
      margin-top: var(--space-10);
    }

    .hero__proof-item:nth-child(2) {
      border-right: 0;
    }

    .hero__proof-item:nth-child(-n + 2) {
      border-bottom: 1px solid var(--rule);
    }

    .hero__proof-item:nth-child(3) {
      padding-left: 0;
    }
  }

  @media (max-width: 480px) {
    .hero__intro {
      font-size: 29px;
    }

    .hero__headline {
      font-size: 36px;
    }

    .hero__proof-item strong {
      font-size: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cursor {
      display: none !important;
      animation: none;
    }
  }
</style>
