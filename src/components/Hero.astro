---
import PortraitFigure from './PortraitFigure.astro';

const proof = [
  { value: '2', label: 'zero-to-one AI products' },
  { value: '20+', label: 'user interviews' },
  { value: '10+', label: 'person product teams' },
  { value: '1M+', label: 'projected users' },
];
---

<section class="hero container">
  <div class="hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Product manager · systems thinker · builder</p>
      <h1 class="hero__headline">
        I find the human signal inside complex systems — and turn it into products that work.
      </h1>
      <p class="hero__lead">
        Zero-to-one AI products and enterprise platforms, from the first interview to a working
        product. Four years at McKinsey; now an MBA candidate at Harvard Business School.
      </p>
      <div class="hero__actions mono">
        <a href="#portfolio" class="hero__primary">See selected work ↓</a>
        <a href="/resume">View résumé →</a>
      </div>
    </div>

    <aside class="hero__signal" aria-label="How Henry works">
      <div class="hero__signal-top">
        <PortraitFigure compact />
        <div>
          <p class="eyebrow">How I work</p>
          <p class="hero__signal-note">
            Start with behavior. Find the constraint. Make the decision visible.
          </p>
        </div>
      </div>
      <div class="hero__signal-flow mono" aria-label="People inform decisions that shape systems">
        <span>People</span>
        <span aria-hidden="true">→</span>
        <strong>Decision</strong>
        <span aria-hidden="true">→</span>
        <span>Systems</span>
      </div>
    </aside>
  </div>

  <div class="hero__proof" aria-label="Selected career proof points">
    {proof.map((item) => (
      <div class="hero__proof-item">
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-14);
    padding-bottom: var(--space-12);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-13);
    align-items: end;
  }

  .hero__headline {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-weight: 600;
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1.08;
    letter-spacing: -0.035em;
    max-width: 820px;
    margin-top: var(--space-5);
  }

  .hero__lead {
    max-width: 670px;
    margin-top: var(--space-8);
    font-size: 20px;
    line-height: 1.55;
    color: var(--text-soft);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-7);
    margin-top: var(--space-9);
  }

  .hero__actions a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .hero__primary {
    background: var(--accent);
    color: var(--paper);
    padding: var(--space-3) var(--space-5);
  }

  .hero__primary:hover {
    background: var(--accent-hover);
    color: var(--paper);
  }

  .hero__signal {
    background: var(--panel);
    border-top: 2px solid var(--accent);
    padding: var(--space-7);
  }

  .hero__signal-top {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: var(--space-6);
  }

  .hero__signal-note {
    margin-top: var(--space-3);
    color: var(--text-soft);
    line-height: 1.5;
  }

  .hero__signal-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    text-align: center;
    color: var(--text-soft);
  }

  .hero__signal-flow strong {
    color: var(--accent);
    font-weight: 400;
  }

  .hero__proof {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: var(--space-12);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .hero__proof-item {
    padding: var(--space-7) var(--space-6);
    border-right: 1px solid var(--rule);
  }

  .hero__proof-item:first-child {
    padding-left: 0;
  }

  .hero__proof-item:last-child {
    border-right: 0;
  }

  .hero__proof-item strong {
    display: block;
    font-family: var(--font-display);
    font-size: 38px;
    line-height: 1;
    color: var(--accent);
  }

  .hero__proof-item span {
    display: block;
    margin-top: var(--space-2);
    color: var(--text-soft);
  }

  @media (max-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--space-10);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-11);
      padding-bottom: var(--space-11);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero__headline {
      font-size: 40px;
      line-height: 1.08;
    }

    .hero__lead {
      font-size: 18px;
    }

    .hero__signal {
      max-width: 520px;
    }

    .hero__proof {
      grid-template-columns: repeat(2, 1fr);
      margin-top: var(--space-10);
    }

    .hero__proof-item:nth-child(2) {
      border-right: 0;
    }

    .hero__proof-item:nth-child(-n + 2) {
      border-bottom: 1px solid var(--rule);
    }

    .hero__proof-item:nth-child(3) {
      padding-left: 0;
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      font-size: 34px;
    }

    .hero__signal-top {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero__proof-item strong {
      font-size: 32px;
    }
  }
</style>
