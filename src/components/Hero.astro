---
import PortraitFigure from './PortraitFigure.astro';
---

<section class="hero container">
  <div class="hero__portrait">
    <PortraitFigure />
  </div>
  <div class="hero__copy">
    <h1 class="hero__headline">
      I enjoy understanding how <span class="accent">systems and people</span> work — and applying
      that insight to build products that solve real problems.
    </h1>
    <ul class="hero__lead">
      <li>Concept to launch on 0-to-1 AI products and enterprise platform modernization.</li>
      <li>Four years at McKinsey in Hong Kong and Boston, most recently Engagement Manager leading product development and management work.</li>
      <li>CS Masters at UPenn, now an MBA Candidate at Harvard Business School.</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    display: flex;
    gap: var(--space-13);
    padding-top: var(--space-14);
    padding-bottom: var(--space-14);
    align-items: flex-start;
  }

  .hero__copy {
    flex: 1;
  }

  .hero__headline {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 42px;
    line-height: 1.3;
    letter-spacing: -0.006em;
    max-width: 660px;
  }

  .hero__headline .accent {
    color: var(--accent);
  }

  .hero__lead {
    margin: var(--space-9) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 640px;
  }

  .hero__lead li {
    position: relative;
    padding-left: var(--space-8);
    font-size: 19px;
    line-height: 1.5;
    color: var(--text-soft);
  }

  .hero__lead li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 12px;
    height: 1px;
    background: var(--accent);
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      gap: var(--space-8);
      padding-top: var(--space-11);
      padding-bottom: var(--space-11);
    }

    .hero__headline {
      font-size: 28px;
      line-height: 1.2;
    }

    .hero__lead {
      font-size: 17px;
      margin-top: var(--space-6);
    }
  }
</style>
