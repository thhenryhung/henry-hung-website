---
interface Props {
  title: string;
  descriptor?: string;
  id?: string;
}
const { title, descriptor, id } = Astro.props;
---

<div class="section-header" id={id}>
  <div class="section-header__row">
    <h2>{title}</h2>
    {descriptor && <p class="mono section-header__descriptor">{descriptor}</p>}
  </div>
  <hr class="rule-heavy" />
</div>

<style>
  .section-header__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .section-header h2 {
    font-size: 32px;
    line-height: 1.2;
  }

  .section-header__descriptor {
    color: var(--meta);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .section-header h2 {
      font-size: 28px;
    }

    .section-header__row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
