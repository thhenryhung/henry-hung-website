---
interface Props {
  compact?: boolean;
  feature?: boolean;
}

const { compact = false, feature = false } = Astro.props;
const portraitAlt = 'Henry Hung standing outdoors in Death Valley, badlands in the background';
---

<figure class:list={["portrait", { "portrait--compact": compact, "portrait--feature": feature }]}>
  {feature ? (
    <picture>
      <source media="(max-width: 768px)" srcset="/images/portrait.jpg" />
      <img
        class="portrait__image"
        src="/images/portrait-square.jpg"
        alt={portraitAlt}
        width="768"
        height="768"
      />
    </picture>
  ) : (
    <img
      class="portrait__image"
      src="/images/portrait.jpg"
      alt={portraitAlt}
      width="212"
      height="258"
    />
  )}
</figure>

<style>
  .portrait {
    margin: 0;
    display: inline-block;
  }

  .portrait picture {
    display: block;
  }

  .portrait__image {
    display: block;
    width: 212px;
    height: 258px;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .portrait--compact .portrait__image {
    width: 128px;
    height: 156px;
  }

  .portrait--feature {
    width: 340px;
    max-width: 100%;
  }

  .portrait--feature .portrait__image {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 768px) {
    .portrait__image {
      width: 152px;
      height: 186px;
    }

    .portrait--feature {
      width: 100%;
      max-width: 360px;
    }

    .portrait--feature .portrait__image {
      aspect-ratio: 4 / 3;
    }
  }
</style>
