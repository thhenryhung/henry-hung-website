---
const contactLinks = [
  { label: 'Email', value: 'thhenryhung@gmail.com', href: 'mailto:thhenryhung@gmail.com', icon: 'email' },
  { label: 'LinkedIn', value: 'linkedin.com/in/henrythhung', href: 'https://www.linkedin.com/in/henrythhung/', icon: 'linkedin' },
  { label: 'GitHub', value: 'github.com/thhenryhung', href: 'https://github.com/thhenryhung/', icon: 'github' },
];
---

<footer class="site-footer" id="contact">
  <div class="container">
    <hr class="rule-heavy" />
    <div class="site-footer__grid">
      <div class="site-footer__left">
        <h2>Get in touch</h2>
      </div>
      <div class="site-footer__right">
        <ul class="contact-list">
          {contactLinks.map((link, i) => (
            <li class={`contact-list__row ${i === 0 ? 'contact-list__row--first' : ''}`}>
              <a href={link.href} class="contact-list__link" target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
                <span class="contact-list__icon" aria-hidden="true">
                  {link.icon === 'email' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="2.5" y="5" width="19" height="14" />
                      <path d="M3 6.5l9 6.5 9-6.5" />
                    </svg>
                  )}
                  {link.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                      <rect x="2.5" y="2.5" width="19" height="19" />
                      <circle cx="7.3" cy="8" r="0.9" fill="currentColor" stroke="none" />
                      <path d="M7.3 11v7" />
                      <path d="M11.5 18v-4.2c0-1.6 1-2.6 2.4-2.6s2.3 1 2.3 2.6V18" />
                      <path d="M11.5 11v7" />
                    </svg>
                  )}
                  {link.icon === 'github' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                      <path d="M12 2.5c-5.2 0-9.5 4.3-9.5 9.5 0 4.2 2.7 7.7 6.4 9 .5.1.6-.2.6-.5v-1.7c-2.6.6-3.2-1.1-3.2-1.1-.4-1.1-1-1.4-1-1.4-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2-.2-4.2-1-4.2-4.6 0-1 .4-1.9 1-2.5-.1-.2-.4-1.2.1-2.5 0 0 .8-.3 2.7 1 .8-.2 1.6-.3 2.5-.3s1.7.1 2.5.3c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.5.6.6 1 1.5 1 2.5 0 3.6-2.2 4.4-4.2 4.6.3.3.6.8.6 1.7v2.5c0 .3.2.6.6.5 3.7-1.3 6.4-4.8 6.4-9 0-5.2-4.3-9.5-9.5-9.5Z" />
                    </svg>
                  )}
                </span>
                <span>
                  <span class="mono contact-list__label">{link.label}</span>
                  <span class="contact-list__value">{link.value}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="site-footer__bottom mono">
      <span>Henry Hung — Boston, MA</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-14);
    padding-bottom: var(--space-13);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-13);
    padding-top: var(--space-11);
    align-items: start;
  }

  .site-footer h2 {
    font-size: 46px;
    line-height: 1.1;
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .contact-list__row {
    border-top: 1px solid var(--rule);
  }

  .contact-list__row--first {
    border-top: 2px solid var(--ink);
  }

  .contact-list__link {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    color: var(--text);
  }

  .contact-list__link:hover {
    color: var(--accent);
  }

  .contact-list__link:hover .contact-list__icon {
    color: var(--accent);
  }

  .contact-list__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: var(--ink);
    flex-shrink: 0;
  }

  .contact-list__icon svg {
    width: 100%;
    height: 100%;
  }

  .contact-list__label {
    display: block;
    color: var(--meta);
  }

  .contact-list__value {
    display: block;
    margin-top: var(--space-1);
    font-family: var(--font-body);
    color: var(--text);
  }

  .site-footer__bottom {
    margin-top: var(--space-14);
    padding-top: var(--space-6);
    border-top: 1px solid var(--rule);
    color: var(--meta);
  }

  @media (max-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .site-footer h2 {
      font-size: 32px;
    }
  }
</style>
