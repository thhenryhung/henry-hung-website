<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to light mode">
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" />
    <path d="M12 2.5v3M12 18.5v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2.5 12h3M18.5 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" />
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z" />
  </svg>
</button>

<script>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    function current() {
      return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
    }

    function apply(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
      btn.classList.toggle('is-light', theme === 'light');
      try {
        localStorage.setItem('theme', theme);
      } catch (e) {}
    }

    apply(current());

    btn.addEventListener('click', () => {
      apply(current() === 'dark' ? 'light' : 'dark');
    });
  })();
</script>

<style>
  .theme-toggle {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--rule);
    background: none;
    color: var(--ink);
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--ink);
  }

  .theme-toggle__icon {
    width: 16px;
    height: 16px;
  }

  .theme-toggle__icon--moon {
    display: none;
  }

  .theme-toggle.is-light .theme-toggle__icon--sun {
    display: none;
  }

  .theme-toggle.is-light .theme-toggle__icon--moon {
    display: block;
  }
</style>
