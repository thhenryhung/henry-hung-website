---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="mockup-frame" role="img" aria-label={label}>
  <slot />
</div>

<style>
  .mockup-frame {
    width: 100%;
    max-width: 680px;
    aspect-ratio: 640 / 380;
    background: var(--panel);
    border: 1px solid var(--rule);
  }

  .mockup-frame :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
