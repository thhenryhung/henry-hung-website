---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="diagram-frame" role="img" aria-label={label}>
  <slot />
</div>

<style>
  .diagram-frame {
    width: 300px;
    height: 168px;
    background: var(--panel);
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .diagram-frame :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 768px) {
    .diagram-frame {
      width: 342px;
      height: 190px;
      max-width: 100%;
    }
  }
</style>
