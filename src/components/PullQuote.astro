---
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<blockquote class="pull-quote">
  <p class="pull-quote__text"><slot /></p>
  {cite && <cite class="mono pull-quote__cite">{cite}</cite>}
</blockquote>

<style>
  .pull-quote {
    margin: var(--space-9) 0;
    padding-left: var(--space-8);
    border-left: 2px solid var(--accent);
  }

  .pull-quote__text {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    line-height: 1.4;
    color: var(--ink);
  }

  .pull-quote__cite {
    display: block;
    margin-top: var(--space-5);
    color: var(--meta);
    font-style: normal;
  }

  @media (max-width: 480px) {
    .pull-quote__text {
      font-size: 22px;
    }
  }
</style>
