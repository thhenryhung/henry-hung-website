---
import RequirementsVisuals from './RequirementsVisuals.astro';

interface Project {
  id: string;
  data: {
    order: string;
    title: string;
    descriptor: string;
    problem: string;
    built: string;
    metric: string;
    metricCaption: string;
    hasCaseStudy: boolean;
    demoUrl?: string;
    demoNote?: string;
    screenshot?: string;
    screenshotAlt?: string;
    diagramLabels?: string[];
    tag?: string;
  };
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="portfolio-explorer" data-portfolio-explorer>
  <div class="portfolio-explorer__tabs" role="tablist" aria-label="Selected projects">
    {projects.map((project, index) => (
      <button
        type="button"
        class="portfolio-explorer__tab"
        id={`project-tab-${project.id}`}
        role="tab"
        aria-controls={`project-panel-${project.id}`}
        aria-selected={index === 0 ? 'true' : 'false'}
        tabindex={index === 0 ? 0 : -1}
        data-project-tab
      >
        <span class="portfolio-explorer__tab-order">{project.data.order}</span>
        <span>{project.data.title}</span>
      </button>
    ))}
  </div>

  <div class="portfolio-explorer__panels">
    {projects.map((project, index) => (
      <article
        class="portfolio-explorer__panel"
        id={`project-panel-${project.id}`}
        role="tabpanel"
        aria-labelledby={`project-tab-${project.id}`}
        hidden={index !== 0}
        data-project-panel
      >
        <div class="portfolio-explorer__feature">
          <div class="portfolio-explorer__copy">
            <h3>{project.data.title}</h3>
            <p class="eyebrow portfolio-explorer__descriptor">{project.data.descriptor}</p>

            <div class="portfolio-explorer__fields">
              <div>
                <p class="mono portfolio-explorer__label">Human signal</p>
                <p>{project.data.problem}</p>
              </div>
              <div>
                <p class="mono portfolio-explorer__label">Product move</p>
                <p>{project.data.built}</p>
              </div>
            </div>

            <div class="portfolio-explorer__result">
              <strong>{project.data.metric}</strong>
              <span>{project.data.metricCaption}</span>
            </div>

            {(project.data.hasCaseStudy || project.data.demoUrl) ? (
              <div class="portfolio-explorer__actions">
                {project.data.hasCaseStudy && (
                  <a href={`/work/${project.id}`} class="mono portfolio-explorer__link">Read detailed case study →</a>
                )}
                {project.data.demoUrl && (
                  <a href={project.data.demoUrl} class="mono portfolio-explorer__link portfolio-explorer__link--secondary" target="_blank" rel="noopener noreferrer">View live demo →</a>
                )}
                {project.data.demoNote && <p class="mono portfolio-explorer__note">{project.data.demoNote}</p>}
              </div>
            ) : <p class="mono portfolio-explorer__note">Case study coming soon</p>}
          </div>

          <div class="portfolio-explorer__visual">
            {project.id === 'agentic-requirements' ? (
              <>
                <p class="mono portfolio-explorer__screen-note">Sanitized screen example to protect client confidentiality</p>
                <RequirementsVisuals compact />
              </>
            ) : project.data.screenshot ? (
              <>
                {project.data.tag === 'Client anonymized' && (
                  <p class="mono portfolio-explorer__screen-note">Sanitized screen example to protect client confidentiality</p>
                )}
                <div class:list={["portfolio-explorer__screen", `portfolio-explorer__screen--${project.id}`]} role="img" aria-label={project.data.screenshotAlt ?? `Product view for ${project.data.title}`}>
                  <img src={project.data.screenshot} alt="" />
                </div>
              </>
            ) : (
              <div class="portfolio-explorer__diagram" role="img" aria-label={`Simplified flow for ${project.data.title}`}>
                <span>{project.data.diagramLabels?.[0] ?? 'Input'}</span>
                <i aria-hidden="true">↓</i>
                <strong>Product decision</strong>
                <i aria-hidden="true">↓</i>
                <span>{project.data.diagramLabels?.at(-1) ?? 'Outcome'}</span>
              </div>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
  <p class="visually-hidden" role="status" aria-live="polite" data-project-live></p>
</div>

<script>
  document.querySelectorAll('[data-portfolio-explorer]').forEach((explorer) => {
    const tabs = Array.from(explorer.querySelectorAll('[data-project-tab]'));
    const panels = Array.from(explorer.querySelectorAll('[data-project-panel]'));
    const live = explorer.querySelector('[data-project-live]');

    const selectTab = (tab, announce = true) => {
      tabs.forEach((candidate, index) => {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
        panels[index].hidden = !selected;
      });
      if (announce && live) live.textContent = `Showing ${tab.textContent.trim()}`;
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowDown', 'ArrowUp', 'ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        let nextIndex = index;
        if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = tabs.length - 1;
        else if (event.key === 'ArrowDown' || event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else nextIndex = (index - 1 + tabs.length) % tabs.length;
        selectTab(tabs[nextIndex]);
        tabs[nextIndex].focus();
      });
    });
  });
</script>

<style>
  .portfolio-explorer {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-8);
    padding-top: var(--space-8);
  }

  .portfolio-explorer__tabs {
    border-top: 2px solid var(--ink);
  }

  .portfolio-explorer__tab {
    width: 100%;
    min-height: 62px;
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-5) var(--space-2);
    color: var(--text-soft);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--rule);
    cursor: pointer;
    font-family: var(--font-meta);
    font-size: 12px;
    line-height: 1.45;
    letter-spacing: 0.08em;
    text-align: left;
    text-transform: uppercase;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }

  .portfolio-explorer__tab:hover,
  .portfolio-explorer__tab[aria-selected='true'] {
    color: var(--accent);
    padding-left: var(--space-4);
  }

  .portfolio-explorer__tab-order {
    color: var(--meta);
  }

  .portfolio-explorer__feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    background: var(--panel);
    min-height: 570px;
  }

  .portfolio-explorer__copy {
    padding: var(--space-9);
  }

  .portfolio-explorer__copy h3 {
    font-size: 40px;
    line-height: 1.15;
    max-width: 620px;
  }

  .portfolio-explorer__descriptor {
    max-width: 620px;
    margin-top: var(--space-4);
  }

  .portfolio-explorer__fields {
    display: grid;
    gap: var(--space-7);
    max-width: 650px;
    margin-top: var(--space-9);
  }

  .portfolio-explorer__fields > div {
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .portfolio-explorer__label {
    color: var(--meta);
    margin-bottom: var(--space-2);
  }

  .portfolio-explorer__fields p:last-child {
    font-size: var(--text-base);
    line-height: 1.58;
  }

  .portfolio-explorer__result {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .portfolio-explorer__result strong {
    font-family: var(--font-display);
    font-size: 42px;
    line-height: 1;
    color: var(--accent);
  }

  .portfolio-explorer__result span {
    color: var(--text-soft);
    line-height: 1.45;
  }

  .portfolio-explorer__actions,
  .portfolio-explorer__note {
    margin-top: var(--space-7);
  }

  .portfolio-explorer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .portfolio-explorer__link {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-5);
    background: var(--accent);
    color: var(--paper);
  }

  .portfolio-explorer__link:hover {
    background: var(--accent-hover);
    color: var(--paper);
  }

  .portfolio-explorer__link--secondary {
    background: transparent;
    color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .portfolio-explorer__link--secondary:hover {
    background: var(--paper);
    color: var(--accent-hover);
    box-shadow: inset 0 0 0 1px var(--accent-hover);
  }

  .portfolio-explorer__note {
    display: inline-block;
    flex-basis: 100%;
    margin-top: 0;
    color: var(--meta);
    text-transform: none;
  }

  .portfolio-explorer__visual {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-left: 1px solid var(--rule);
  }

  .portfolio-explorer__screen {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--panel-strong);
  }

  .portfolio-explorer__screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.45s ease;
  }

  .portfolio-explorer__screen-note {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--rule);
    background: var(--panel-strong);
    color: var(--meta);
    font-size: 8px;
    line-height: 1.45;
  }

  .portfolio-explorer__screen--insurance-copilot,
  .portfolio-explorer__screen--section-j {
    display: flex;
    align-items: center;
    padding: var(--space-5);
  }

  .portfolio-explorer__screen--insurance-copilot img,
  .portfolio-explorer__screen--section-j img {
    height: auto;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .portfolio-explorer__panel:hover .portfolio-explorer__screen img {
    transform: scale(1.025);
  }

  .portfolio-explorer__diagram {
    flex: 1;
    display: grid;
    align-content: center;
    gap: var(--space-3);
    padding: var(--space-8);
  }

  .portfolio-explorer__diagram span,
  .portfolio-explorer__diagram strong {
    padding: var(--space-4);
    border: 1px solid var(--diagram-line);
    text-align: center;
    font-family: var(--font-meta);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .portfolio-explorer__diagram strong {
    background: var(--accent);
    color: var(--paper);
    border-color: var(--accent);
    font-weight: 400;
  }

  .portfolio-explorer__diagram i {
    color: var(--accent);
    font-style: normal;
    text-align: center;
  }

  :global(.no-js) .portfolio-explorer__tab {
    display: none;
  }

  :global(.no-js) .portfolio-explorer__panel[hidden] {
    display: block;
  }

  :global(.no-js) .portfolio-explorer__panels {
    display: grid;
    gap: var(--space-8);
  }

  @media (max-width: 1024px) {
    .portfolio-explorer {
      grid-template-columns: 190px minmax(0, 1fr);
    }

    .portfolio-explorer__feature {
      grid-template-columns: minmax(0, 1fr) 260px;
    }
  }

  @media (max-width: 768px) {
    .portfolio-explorer {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .portfolio-explorer__tabs {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: hidden;
      border-top-width: 1px;
      border-bottom: 1px solid var(--rule);
    }

    .portfolio-explorer__tab {
      display: block;
      min-width: 0;
      min-height: 52px;
      padding: var(--space-4) var(--space-2);
      border-bottom: 0;
      border-right: 1px solid var(--rule);
      white-space: nowrap;
      text-align: center;
    }

    .portfolio-explorer__tab:last-child {
      border-right: 0;
    }

    .portfolio-explorer__tab span:last-child {
      display: none;
    }

    .portfolio-explorer__tab:hover,
    .portfolio-explorer__tab[aria-selected='true'] {
      padding-left: var(--space-2);
      background: var(--panel);
    }

    .portfolio-explorer__feature {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .portfolio-explorer__visual {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }

    .portfolio-explorer__screen {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 480px) {
    .portfolio-explorer__copy {
      padding: var(--space-7);
    }

    .portfolio-explorer__copy h3 {
      font-size: 34px;
    }

    .portfolio-explorer__result {
      grid-template-columns: 1fr;
    }

    .portfolio-explorer__result strong {
      font-size: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-explorer__tab,
    .portfolio-explorer__screen img {
      transition: none;
    }
  }
</style>
