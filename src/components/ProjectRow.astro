---
import DiagramFrame from './DiagramFrame.astro';
import MetricBlock from './MetricBlock.astro';

interface Props {
  order: string;
  title: string;
  descriptor: string;
  problem: string;
  built: string;
  metric: string;
  metricCaption: string;
  href?: string;
  demoUrl?: string;
  demoNote?: string;
  screenshot?: string;
  screenshotAlt?: string;
  diagramLabels?: string[];
  tag?: string;
}
const {
  order,
  title,
  descriptor,
  problem,
  built,
  metric,
  metricCaption,
  href,
  demoUrl,
  demoNote,
  screenshot,
  screenshotAlt,
  diagramLabels,
  tag,
} = Astro.props;
---

<article class="project-row">
  <div class="project-row__index mono">{order}</div>

  <div class="project-row__main">
    <h3 class="project-row__title">{title}</h3>
    <p class="project-row__descriptor">{descriptor}</p>

    <div class="project-row__fields">
      <div class="project-row__field">
        <p class="mono project-row__field-label">Problem</p>
        <p class="project-row__field-value">{problem}</p>
      </div>
      <div class="project-row__field">
        <p class="mono project-row__field-label">Built</p>
        <p class="project-row__field-value">{built}</p>
      </div>
    </div>

    {href ? (
      <a href={href} class="mono project-row__link">Read the case study →</a>
    ) : demoUrl ? (
      <div class="project-row__demo">
        <a href={demoUrl} class="mono project-row__link" target="_blank" rel="noopener noreferrer">
          View live demo →
        </a>
        {demoNote && <p class="mono project-row__demo-note">{demoNote}</p>}
      </div>
    ) : (
      <p class="mono project-row__link project-row__link--disabled">Case study coming soon</p>
    )}
  </div>

  <div class="project-row__aside">
    <DiagramFrame label={screenshotAlt ?? `Simplified architecture diagram for ${title}`}>
      {screenshot ? (
        <img src={screenshot} alt="" class="project-row__screenshot" />
      ) : diagramLabels && diagramLabels.length === 2 ? (
        <svg viewBox="0 0 300 168" xmlns="http://www.w3.org/2000/svg">
          <line x1="140" y1="84" x2="176" y2="84" stroke="var(--diagram-faint)" />
          <rect x="34" y="66" width="106" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="87" y="88" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[0]}</text>
          <rect x="176" y="66" width="106" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="229" y="88" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[1]}</text>
        </svg>
      ) : diagramLabels && diagramLabels.length === 3 ? (
        <svg viewBox="0 0 300 168" xmlns="http://www.w3.org/2000/svg">
          <rect x="16" y="24" width="88" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="60" y="46" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[0]}</text>
          <rect x="196" y="24" width="88" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="240" y="46" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[1]}</text>
          <rect x="106" y="108" width="88" height="36" fill="none" stroke="var(--diagram-line)" />
          <text x="150" y="130" text-anchor="middle" font-family="var(--font-meta)" font-size="8" fill="var(--text-muted)">{diagramLabels[2]}</text>
          <line x1="104" y1="42" x2="196" y2="42" stroke="var(--diagram-faint)" />
          <line x1="150" y1="60" x2="150" y2="108" stroke="var(--diagram-faint)" />
        </svg>
      ) : (
        <svg viewBox="0 0 300 168" xmlns="http://www.w3.org/2000/svg">
          <rect x="20" y="24" width="80" height="36" fill="none" stroke="var(--diagram-line)" />
          <rect x="200" y="24" width="80" height="36" fill="none" stroke="var(--diagram-line)" />
          <rect x="110" y="108" width="80" height="36" fill="none" stroke="var(--diagram-line)" />
          <line x1="100" y1="42" x2="200" y2="42" stroke="var(--diagram-faint)" />
          <line x1="150" y1="60" x2="150" y2="108" stroke="var(--diagram-faint)" />
        </svg>
      )}
    </DiagramFrame>
    <MetricBlock metric={metric} caption={metricCaption} />
    {tag && <p class="mono project-row__tag">{tag}</p>}
  </div>
</article>

<style>
  .project-row {
    display: grid;
    grid-template-columns: 44px 1fr 300px;
    gap: var(--space-13);
    padding: var(--space-9) 0;
    border-bottom: 1px solid var(--rule);
  }

  .project-row__index {
    color: var(--accent);
    font-size: 11px;
    padding-top: var(--space-1);
  }

  .project-row__title {
    font-size: 26px;
    line-height: 1.25;
  }

  .project-row__descriptor {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 16px;
    line-height: 1.45;
    color: var(--text-muted);
    margin-top: var(--space-2);
  }

  .project-row__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-6);
    max-width: 560px;
  }

  .project-row__field-label {
    color: var(--meta);
    margin-bottom: var(--space-1);
  }

  .project-row__field-value {
    font-size: 16px;
    line-height: 1.58;
    color: var(--text);
  }

  .project-row__link {
    display: inline-block;
    margin-top: var(--space-6);
    color: var(--accent);
  }

  .project-row__link--disabled {
    color: var(--meta);
  }

  .project-row__demo-note {
    margin-top: var(--space-2);
    color: var(--meta);
  }

  .project-row__screenshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .project-row__tag {
    color: var(--meta);
    margin-top: calc(-1 * var(--space-6));
  }

  .project-row__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (max-width: 768px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
