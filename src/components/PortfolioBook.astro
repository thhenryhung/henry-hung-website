---
import BookPage from './BookPage.astro';

interface Project {
  id: string;
  data: {
    order: string;
    title: string;
    descriptor: string;
    problem: string;
    built: string;
    metric: string;
    metricCaption: string;
    hasCaseStudy: boolean;
    demoUrl?: string;
    demoNote?: string;
    screenshot?: string;
    screenshotAlt?: string;
    diagramLabels?: string[];
    tag?: string;
  };
}

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---

<div class="book-wrapper">
  <div class="book" id="portfolio-book">
    <div class="book__pages">
      <div class="book__spine" aria-hidden="true"></div>

      {projects.map((project, i) => (
        <div class="book-page" data-index={i}>
          <div class="book-page__face book-page__face--front">
            <BookPage
              order={project.data.order}
              title={project.data.title}
              descriptor={project.data.descriptor}
              problem={project.data.problem}
              built={project.data.built}
              metric={project.data.metric}
              metricCaption={project.data.metricCaption}
              href={project.data.hasCaseStudy ? `/work/${project.id}` : undefined}
              demoUrl={project.data.demoUrl}
              demoNote={project.data.demoNote}
              screenshot={project.data.screenshot}
              screenshotAlt={project.data.screenshotAlt}
              diagramLabels={project.data.diagramLabels}
              tag={project.data.tag}
            />
            <div class="book-page__zone book-page__zone--prev" aria-hidden="true">‹</div>
            <div class="book-page__zone book-page__zone--next" aria-hidden="true">›</div>
          </div>
          <div class="book-page__face book-page__face--back"></div>
        </div>
      ))}
    </div>
  </div>

  <div class="book__controls">
    <button type="button" id="book-prev" class="mono book__control" aria-label="Previous page">← Prev</button>
    <p class="mono book__indicator" id="book-indicator" aria-hidden="true"></p>
    <button type="button" id="book-next" class="mono book__control" aria-label="Next page">Next →</button>
  </div>

  <p id="book-live" class="visually-hidden" role="status" aria-live="polite"></p>
</div>

<script>
  (function () {
    const wrapper = document.querySelector('.book-wrapper');
    if (!wrapper) return;

    const book = wrapper.querySelector('#portfolio-book');
    const pages = Array.from(wrapper.querySelectorAll('.book-page'));
    const prevBtn = wrapper.querySelector('#book-prev');
    const nextBtn = wrapper.querySelector('#book-next');
    const indicator = wrapper.querySelector('#book-indicator');
    const live = wrapper.querySelector('#book-live');
    const total = pages.length;

    let current = 0;

    function titleFor(index) {
      const face = pages[index].querySelector('.book-page__face--front');
      const heading = face.querySelector('h2, h3');
      return heading ? heading.textContent.trim() : 'Page ' + (index + 1);
    }

    function render() {
      pages.forEach((page, i) => {
        const turned = i < current;
        page.classList.toggle('is-turned', turned);
        page.style.zIndex = turned ? String(i - total) : String(total - i);

        const isCurrent = i === current;
        const front = page.querySelector('.book-page__face--front');
        front.setAttribute('aria-hidden', isCurrent ? 'false' : 'true');
        front.querySelectorAll('a, button').forEach((el) => {
          el.tabIndex = isCurrent ? 0 : -1;
        });
        front.classList.toggle('no-prev', current === 0);
        front.classList.toggle('no-next', current === total - 1);
      });

      prevBtn.disabled = current === 0;
      nextBtn.disabled = current === total - 1;
      indicator.textContent = 'Page ' + (current + 1) + ' of ' + total;
    }

    function goto(index) {
      const clamped = Math.max(0, Math.min(total - 1, index));
      if (clamped === current) return;
      current = clamped;
      render();
      live.textContent = 'Now viewing: ' + titleFor(current) + ', page ' + (current + 1) + ' of ' + total;
    }

    prevBtn.addEventListener('click', () => goto(current - 1));
    nextBtn.addEventListener('click', () => goto(current + 1));

    pages.forEach((page, i) => {
      const front = page.querySelector('.book-page__face--front');
      front.addEventListener('click', (event) => {
        if (i !== current) return;
        if (event.target.closest('a, button')) return;
        const rect = front.getBoundingClientRect();
        const x = event.clientX - rect.left;
        if (x > rect.width * 0.82) goto(current + 1);
        else if (x < rect.width * 0.18 && current > 0) goto(current - 1);
      });
    });

    book.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') goto(current + 1);
      else if (event.key === 'ArrowLeft') goto(current - 1);
      else if (event.key === 'Home') goto(0);
      else if (event.key === 'End') goto(total - 1);
      else return;
      event.preventDefault();
    });
    book.setAttribute('tabindex', '0');

    render();
  })();
</script>

<style>
  .book-wrapper {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: var(--space-8) 0 var(--space-11);
  }

  .book {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 8;
    perspective: 2600px;
    outline: none;
  }

  .book__pages {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    transform-style: preserve-3d;
  }

  .book__spine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--ink);
    z-index: 1000;
  }

  .book-page {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform-origin: left center;
    transform: rotateY(0deg);
    transition: transform 0.7s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .book-page.is-turned {
    transform: rotateY(-180deg);
  }

  .book-page__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    background: var(--paper);
    border: 1px solid var(--rule);
    overflow: hidden;
  }

  .book-page__zone {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 18%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 28px;
    transition: opacity 0.2s ease;
  }

  .book-page__zone--prev {
    left: 0;
  }

  .book-page__zone--next {
    right: 0;
  }

  .book-page__face--front:hover .book-page__zone {
    opacity: 0.7;
  }

  .book-page__face--front.no-prev .book-page__zone--prev,
  .book-page__face--front.no-next .book-page__zone--next {
    display: none;
  }

  .book-page__face--back {
    background: var(--panel);
    transform: rotateY(180deg);
  }

  .book__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    margin-top: var(--space-7);
  }

  .book__control {
    color: var(--accent);
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2) 0;
  }

  .book__control:disabled {
    color: var(--meta);
    cursor: default;
  }

  .book__indicator {
    color: var(--meta);
  }
</style>
