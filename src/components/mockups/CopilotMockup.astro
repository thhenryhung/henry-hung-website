---
import MockupFrame from '../MockupFrame.astro';
---

<MockupFrame label="Generic mockup of an agent co-pilot, showing a prioritized day planner, a customer insight panel with a recommendation, and a drafted chat reply">
  <svg viewBox="0 0 640 380" xmlns="http://www.w3.org/2000/svg" font-family="var(--font-meta)">
    <rect x="1" y="1" width="638" height="378" fill="var(--paper)" stroke="var(--rule)" />

    <rect x="1" y="1" width="308" height="252" fill="var(--paper)" stroke="var(--rule)" />
    <text x="24" y="30" font-size="11" letter-spacing="0.08em" fill="var(--meta)">TODAY</text>
    <line x1="24" y1="42" x2="286" y2="42" stroke="var(--ink)" stroke-width="2" />

    <rect x="24" y="54" width="3" height="30" fill="var(--accent)" />
    <text x="40" y="70" font-family="var(--font-body)" font-size="12.5" fill="var(--text)">Follow up: Customer A</text>
    <text x="40" y="86" font-size="9.5" fill="var(--meta)">9:30 AM · policy renewal in 12 days</text>

    <rect x="24" y="98" width="3" height="30" fill="var(--diagram-faint)" />
    <text x="40" y="114" font-family="var(--font-body)" font-size="12.5" fill="var(--text)">Follow up: Customer B</text>
    <text x="40" y="130" font-size="9.5" fill="var(--meta)">11:00 AM · new dependent added</text>

    <rect x="24" y="142" width="3" height="30" fill="var(--diagram-faint)" />
    <text x="40" y="158" font-family="var(--font-body)" font-size="12.5" fill="var(--text)">Service queries &amp; paperwork</text>
    <text x="40" y="174" font-size="9.5" fill="var(--meta)">1:00 – 2:30 PM</text>

    <rect x="24" y="186" width="3" height="30" fill="var(--diagram-faint)" />
    <text x="40" y="202" font-family="var(--font-body)" font-size="12.5" fill="var(--text)">Follow up: Customer C</text>
    <text x="40" y="218" font-size="9.5" fill="var(--meta)">3:30 PM · asked about coverage options</text>

    <rect x="332" y="1" width="307" height="252" fill="var(--paper)" stroke="var(--rule)" />
    <circle cx="352" cy="30" r="12" fill="none" stroke="var(--diagram-line)" />
    <text x="374" y="27" font-family="var(--font-body)" font-size="14" fill="var(--ink)">Customer A</text>
    <text x="374" y="42" font-size="9" letter-spacing="0.04em" fill="var(--meta)">NEW CLIENT · HIGH ENGAGEMENT</text>

    <text x="352" y="76" font-size="9.5" letter-spacing="0.08em" fill="var(--meta)">KEY INSIGHT</text>
    <text x="352" y="94" font-family="var(--font-body)" font-size="12" fill="var(--text)">Recently reviewed family coverage</text>
    <text x="352" y="110" font-family="var(--font-body)" font-size="12" fill="var(--text)">options; renewal due in 12 days.</text>

    <rect x="352" y="130" width="270" height="72" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.6" />
    <text x="366" y="150" font-size="9.5" letter-spacing="0.06em" fill="var(--accent)">SUGGESTED NEXT STEP</text>
    <text x="366" y="170" font-family="var(--font-body)" font-size="12" fill="var(--text)">Offer a short coverage review</text>
    <text x="366" y="186" font-family="var(--font-body)" font-size="12" fill="var(--text)">before the renewal date.</text>

    <rect x="352" y="216" width="140" height="28" fill="var(--ink)" />
    <text x="368" y="234" font-size="10" letter-spacing="0.06em" fill="var(--paper)">START CONVERSATION</text>

    <rect x="1" y="264" width="638" height="115" fill="var(--panel)" stroke="var(--rule)" />
    <text x="24" y="288" font-size="10" letter-spacing="0.08em" fill="var(--meta)">CHAT PORTAL — DRAFTED REPLY</text>

    <rect x="24" y="298" width="280" height="42" fill="var(--paper)" stroke="var(--rule)" />
    <text x="36" y="316" font-family="var(--font-body)" font-size="11.5" fill="var(--text)">"Thanks for checking in — is the plan</text>
    <text x="36" y="332" font-family="var(--font-body)" font-size="11.5" fill="var(--text)">still a good fit for the family?"</text>

    <rect x="320" y="298" width="296" height="58" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.6" />
    <text x="332" y="314" font-family="var(--font-body)" font-size="11.5" fill="var(--text)">"Glad to hear it! Since your renewal is</text>
    <text x="332" y="329" font-family="var(--font-body)" font-size="11.5" fill="var(--text)">coming up, want to walk through a</text>
    <text x="332" y="344" font-family="var(--font-body)" font-size="11.5" fill="var(--text)">quick coverage review together?"</text>

    <rect x="516" y="356" width="100" height="20" fill="var(--ink)" />
    <text x="530" y="370" font-size="9.5" letter-spacing="0.05em" fill="var(--paper)">EDIT &amp; SEND</text>
  </svg>
</MockupFrame>
