---
import MockupFrame from '../MockupFrame.astro';
---

<MockupFrame label="Generic mockup of a customer-facing assistant, showing a question, a drafted answer with a cited source, and routing to a specialist advisor">
  <svg viewBox="0 0 640 380" xmlns="http://www.w3.org/2000/svg" font-family="var(--font-meta)">
    <rect x="1" y="1" width="638" height="378" fill="var(--paper)" stroke="var(--rule)" />

    <rect x="1" y="1" width="638" height="40" fill="var(--panel)" stroke="var(--rule)" />
    <text x="24" y="25" font-size="11" letter-spacing="0.08em" fill="var(--meta)">ASSISTANT</text>
    <circle cx="608" cy="21" r="10" fill="none" stroke="var(--diagram-line)" />

    <rect x="296" y="60" width="320" height="46" fill="var(--panel)" stroke="var(--rule)" />
    <text x="316" y="80" font-family="var(--font-body)" font-size="13" fill="var(--text)">Is my upcoming visit covered</text>
    <text x="316" y="98" font-family="var(--font-body)" font-size="13" fill="var(--text)">under my current plan?</text>

    <rect x="24" y="122" width="360" height="88" fill="var(--paper)" stroke="var(--rule)" />
    <rect x="24" y="122" width="3" height="88" fill="var(--accent)" />
    <text x="44" y="148" font-family="var(--font-body)" font-size="13" fill="var(--text)">Here's what your plan covers for this</text>
    <text x="44" y="168" font-family="var(--font-body)" font-size="13" fill="var(--text)">visit, and where the coverage gap is.</text>
    <text x="44" y="194" font-size="9.5" letter-spacing="0.04em" fill="var(--meta)">SOURCE: YOUR POLICY SUMMARY</text>

    <line x1="24" y1="234" x2="616" y2="234" stroke="var(--rule)" />
    <text x="24" y="256" font-size="10" letter-spacing="0.1em" fill="var(--meta)">ROUTED TO A SPECIALIST</text>

    <rect x="24" y="268" width="188" height="76" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.6" />
    <path d="M56 288a10 10 0 0 1 20 0v8a10 12 0 0 1 -10 12a10 12 0 0 1 -10 -12z" fill="none" stroke="var(--accent)" stroke-width="1.3" />
    <text x="45" y="330" font-size="11" fill="var(--ink)">Coverage Advisor</text>

    <rect x="226" y="268" width="188" height="76" fill="var(--paper)" stroke="var(--rule)" />
    <path d="M320 286c6-8 18-4 18 4 0 8-12 16-18 20-6-4-18-12-18-20 0-8 12-12 18-4z" fill="none" stroke="var(--diagram-line)" stroke-width="1.3" />
    <text x="271" y="330" font-size="11" fill="var(--text-muted)">Wellness Guide</text>

    <rect x="428" y="268" width="188" height="76" fill="var(--paper)" stroke="var(--rule)" />
    <circle cx="522" cy="292" r="9" fill="none" stroke="var(--diagram-line)" stroke-width="1.3" />
    <path d="M522 301v14M515 322h14" stroke="var(--diagram-line)" stroke-width="1.3" />
    <text x="480" y="330" font-size="11" fill="var(--text-muted)">Care Navigator</text>
  </svg>
</MockupFrame>
