---
import FactList from './FactList.astro';
import MetricBlock from './MetricBlock.astro';

interface Fact {
  label: string;
  value: string;
}
interface Props {
  facts: Fact[];
  metric: string;
  metricCaption: string;
}
const { facts, metric, metricCaption } = Astro.props;
---

<aside class="case-rail">
  <a href="/#portfolio" class="mono case-rail__back">← Back to portfolio</a>

  <details class="case-rail__glance" open>
    <summary class="mono">At a glance <span aria-hidden="true">+</span></summary>
    <div class="case-rail__facts">
      <p class="mono case-rail__label">At a glance</p>
      <FactList facts={facts} />
    </div>

    <div class="case-rail__metric">
      <MetricBlock metric={metric} caption={metricCaption} variant="rail" />
    </div>
  </details>

  <nav class="case-rail__nav mono" id="case-rail-nav" aria-label="Case study sections">
    <a href="#problem">01 — The problem</a>
    <a href="#built">02 — What I built</a>
    <a href="#decisions">03 — Key decisions</a>
    <a href="#outcome">04 — Outcome</a>
  </nav>
</aside>

<script>
  (function () {
    const glance = document.querySelector('.case-rail__glance');
    const mobile = window.matchMedia('(max-width: 1024px)');
    if (glance && mobile.matches) glance.removeAttribute('open');

    const nav = document.getElementById('case-rail-nav');
    if (!nav) return;

    const links = Array.from(nav.querySelectorAll('a'));
    const sections = links
      .map((link) => document.querySelector(link.getAttribute('href')))
      .filter((el) => el);
    if (!sections.length) return;

    const setActive = (id) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link.getAttribute('href') === '#' + id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-20% 0px -70% 0px' }
    );
    sections.forEach((section) => observer.observe(section));
  })();
</script>

<style>
  .case-rail {
    position: sticky;
    top: var(--space-11);
    display: flex;
    flex-direction: column;
    gap: var(--space-11);
  }

  .case-rail__back {
    color: var(--text-soft);
  }

  .case-rail__label {
    color: var(--meta);
    margin-bottom: var(--space-3);
  }

  .case-rail__glance summary {
    display: none;
  }

  .case-rail__metric {
    margin-top: var(--space-11);
  }

  .case-rail__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .case-rail__nav a {
    color: var(--text-soft);
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
    margin-left: calc(-1 * var(--space-3) - 2px);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .case-rail__nav a:hover {
    color: var(--accent);
  }

  .case-rail__nav a.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  @media (max-width: 1024px) {
    .case-rail {
      position: static;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      padding: var(--space-6) 0;
      border-top: 1px solid var(--rule);
      border-bottom: 1px solid var(--rule);
    }

    .case-rail__back {
      order: -1;
    }

    .case-rail__glance summary {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: space-between;
      color: var(--accent);
      cursor: pointer;
      list-style: none;
    }

    .case-rail__glance summary::-webkit-details-marker {
      display: none;
    }

    .case-rail__glance[open] summary span {
      transform: rotate(45deg);
    }

    .case-rail__facts {
      margin-top: var(--space-5);
    }

    .case-rail__label {
      display: none;
    }

    .case-rail__nav {
      flex-direction: row;
      gap: var(--space-6);
      overflow-x: auto;
      padding-top: var(--space-5);
      white-space: nowrap;
    }

    .case-rail__nav a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      border-left: 0;
      border-bottom: 2px solid transparent;
      padding-left: 0;
      margin-left: 0;
    }

    .case-rail__nav a.is-active {
      border-left-color: transparent;
      border-bottom-color: var(--accent);
    }
  }
</style>
